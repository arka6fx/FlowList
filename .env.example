# Copy this file to `.env` and fill in real values.
#
# FlowList uses Cloudflare D1 (SQLite) via a Worker binding - no DATABASE_URL needed.
# For local dev, bindings are provided by miniflare (initOpenNextCloudflareForDev).
# See wrangler.jsonc for the D1 binding configuration.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
